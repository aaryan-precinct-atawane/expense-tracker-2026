<div class="dashboard">
  <h1>My Expense Tracker</h1>
  <p>Track and manage your daily expenses.</p>

  <div class="stats-container">
    <div class="stat-card">
      <h3>Total Expenses</h3>
      <h2><%= number_to_currency(@total_expenses, unit: "₹") %></h2>
    </div>

    <div class="stat-card">
      <h3>Total Transactions</h3>
      <h2><%= @total_transactions %></h2>
    </div>
  </div>

  <h2>Recent Expenses</h2>

  <% if @recent_expenses.any? %>
    <div class="expenses-list">
      <% @recent_expenses.each do |expense| %>
        <div class="expense-item">
          <div>
            <strong><%= expense.title %></strong>
            <p><%= expense.category %> |
              <%= expense.date.strftime("%d %b %Y") %>
            </p>
          </div>

          <strong>
            <%= number_to_currency(expense.amount, unit: "₹") %>
          </strong>
        </div>
      <% end %>
    </div>
  <% else %>
    <p>No expenses added yet.</p>
  <% end %>

  <%= link_to "Add New Expense", new_expense_path,
      class: "primary-button" %>

  <%= link_to "View All Expenses", expenses_path,
      class: "secondary-button" %>
</div>
