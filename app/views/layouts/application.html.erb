
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Expense Tracker 2026" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Expense Tracker 2026">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <!-- Navigation Bar -->
    <nav class="navbar">
      <div class="navbar-container">

        <%= link_to "Expense Tracker", root_path,
            class: "navbar-brand" %>

        <div class="navbar-links">
          <%= link_to "Dashboard", root_path %>

          <%= link_to "All Expenses", expenses_path %>

          <%= link_to "Add Expense", new_expense_path,
              class: "navbar-button" %>
        </div>

      </div>
    </nav>

    <!-- Main Page Content -->
    <main class="page-content">
      <%= yield %>
    </main>

  </body>
</html>


