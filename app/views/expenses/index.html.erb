<p style="color: green"><%= notice %></p>

<% content_for :title, "Expenses" %>

<h1>Expenses</h1>


<%= form_with url: expenses_path, method: :get do %>
  <div class="search-container">
    <%= text_field_tag :query, @query,
        placeholder: "Search by title or category..." %>

    <%= submit_tag "Search", class: "primary-button" %>

    <%= link_to "Clear", expenses_path,
        class: "secondary-button" if @query.present? %>
  </div>
<% end %>


<div id="expenses">
  <% @expenses.each do |expense| %>
    <%= render expense %>
    <p>
      <%= link_to "Show this expense", expense %>
    </p>
  <% end %>
</div>

<%= link_to "New expense", new_expense_path %>
